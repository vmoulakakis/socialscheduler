# OpenPost self-host configuration for SocialScheduler
# Copy to .env on the machine that runs Docker. Never commit real secrets.

OPENPOST_APP_URL=https://openpost.example.com
OPENPOST_PUBLIC_URL=https://openpost.example.com
TZ=Europe/Athens

# Generate unique values before first run, for example:
#   openssl rand -base64 32
OPENPOST_JWT_SECRET=replace-with-random-min-32-char-secret
OPENPOST_ENCRYPTION_KEY=replace-with-random-min-32-char-secret

# Self-host mode has no OpenPost software subscription.
OPENPOST_EDITION=selfhost
OPENPOST_DATABASE_DRIVER=sqlite
OPENPOST_STORAGE_DRIVER=local
OPENPOST_TELEMETRY_ENABLED=false
OPENPOST_EMAIL_VERIFICATION_REQUIRED=false

# Social provider apps. Configure only the providers you use.
# Facebook + Instagram may use the same Meta app credentials.
# Default callbacks are derived from OPENPOST_APP_URL:
#   /api/v1/accounts/facebook/callback
#   /api/v1/accounts/instagram/callback
#   /api/v1/accounts/tiktok/callback
#
# Example JSON shape (DO NOT put real secrets in Git):
# OPENPOST_PROVIDER_APPS=[{"provider":"facebook","client_id":"META_APP_ID","client_secret":"META_APP_SECRET"},{"provider":"instagram","client_id":"META_APP_ID","client_secret":"META_APP_SECRET"},{"provider":"tiktok","client_id":"TIKTOK_CLIENT_KEY","client_secret":"TIKTOK_CLIENT_SECRET"}]
OPENPOST_PROVIDER_APPS=[]

# LinkedIn is supported by OpenPost as well. The SocialMarket outbox currently
# claims Facebook / Instagram / TikTok only, so LinkedIn connection can be
# prepared now but SocialScheduler publishing will remain disabled until the
# upstream outbox contract is extended.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
OPENPOST_LINKEDIN_ORGANIZATIONS_ENABLED=false

# Optional explicit provider behavior/version controls.
META_GRAPH_API_VERSION=v25.0
