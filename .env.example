# Existing Buffer writer (kept during browser prototype)
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=68a86463018d512de98d6315
SCHEDULER_MODE=live
ASSET_REPOSITORY=vmoulakakis/socialscheduler
ASSET_REF=main
ALERT_WEBHOOK_URL=

# Direct Browser Publisher prototype — Browserbase cloud browser.
# Never put these values in source control; use GitHub Actions secrets.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# One persistent Browserbase Context per authenticated social login.
# Create these through the login workflow, then save the returned IDs as secrets.
BROWSERBASE_CONTEXT_META=
BROWSERBASE_CONTEXT_TIKTOK=
BROWSERBASE_CONTEXT_LINKEDIN=

# Browser mode stays dry-run until selectors are visually validated per account.
DIRECT_BROWSER_MODE=dry-run
