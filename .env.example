# Required. Create in Buffer > Settings > API.
BUFFER_API_KEY=

# Already configured for this project; override only if organization changes.
BUFFER_ORGANIZATION_ID=68a86463018d512de98d6315

# live = create Buffer Ideas/posts; dry-run = reconcile and print actions only.
SCHEDULER_MODE=live

# Public GitHub repo used to resolve committed assets under assets/.
ASSET_REPOSITORY=vmoulakakis/socialscheduler
ASSET_REF=main

# Optional notification webhook. Scheduler itself does not require it.
ALERT_WEBHOOK_URL=
