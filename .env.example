# Publisher backend: buffer, postiz, postzen, brightbean, or openpost depending on the workflow.
PUBLISHER_BACKEND=buffer

# Buffer publisher.
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=68a86463018d512de98d6315

# Postiz publisher. Cloud default shown; self-hosted installs should point
# POSTIZ_API_URL at their own /public/v1 API base.
POSTIZ_API_KEY=
POSTIZ_API_URL=https://api.postiz.com/public/v1
POSTIZ_INTEGRATION_FACEBOOK=
POSTIZ_INTEGRATION_INSTAGRAM=
POSTIZ_INTEGRATION_TIKTOK=

# PostZen publisher.
POSTZEN_API_KEY=
POSTZEN_API_URL=https://api.postzen.dev
POSTZEN_PLATFORMS=linkedin,instagram,facebook

# BrightBean publisher.
BRIGHTBEAN_API_KEY=
BRIGHTBEAN_API_URL=https://studio.brightbean.xyz/api/v1
BRIGHTBEAN_PLATFORMS=linkedin,facebook,instagram,tiktok
BRIGHTBEAN_ACCOUNT_LINKEDIN=
BRIGHTBEAN_ACCOUNT_FACEBOOK=
BRIGHTBEAN_ACCOUNT_INSTAGRAM=
BRIGHTBEAN_ACCOUNT_TIKTOK=

# live = create publisher schedules; dry-run = inspect without publisher mutations.
SCHEDULER_MODE=live

# Production content comes only from the canonical VMDB SocialMarket outbox.
CONTENT_SOURCE=socialmarket_outbox
SOCIALMARKET_OUTBOX_URL=https://gqpbskssrvpfjtujwezc.supabase.co/functions/v1/publishing-outbox
SOCIALMARKET_OIDC_AUDIENCE=socialmarket-v2-publishing

# Public GitHub repo used to resolve committed assets under assets/.
ASSET_REPOSITORY=vmoulakakis/socialscheduler
ASSET_REF=main

# Optional notification webhook. Scheduler itself does not require it.
ALERT_WEBHOOK_URL=
